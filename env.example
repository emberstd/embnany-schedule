# Copy to .env.local and fill in your values:
# cp env.example .env.local

# Notion Integration Secret (starts with ntn_ or secret_)
NOTION_API_KEY=your_notion_integration_secret_here

# Database ID (32 chars, from database URL)
NOTION_DATABASE_ID=your_32_char_database_id_here

# Optional: skip database lookup (Notion SDK v5 data source id)
# NOTION_DATA_SOURCE_ID=

# Optional: exact property names in your Notion database (defaults below)
# NOTION_PROP_TITLE=Title
# NOTION_PROP_DATE=Date
# NOTION_PROP_LOCATION=Location
# NOTION_PROP_GUESTS=People
# NOTION_PROP_KEYWORD=Trending Keyword
# NOTION_PROP_HASHTAG=Hashtag
# NOTION_PROP_OFFICIAL_URL=Official Post
# NOTION_PROP_TYPE=Type

# Optional: timezone for UTC-only Notion timestamps (default: Asia/Bangkok)
# NOTION_TIMEZONE=Asia/Bangkok

# Comma-separated Type values to hide on the site (default: 聊天直播)
# NOTION_EXCLUDE_TYPES=聊天直播
# Set empty to show all types: NOTION_EXCLUDE_TYPES=
