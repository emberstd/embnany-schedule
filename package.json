{
  "name": "emibonnieany",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "npx --legacy-peer-deps @cloudflare/next-on-pages@1",
    "cf:build": "opennextjs-cloudflare build -c wrangler.worker.jsonc",
    "cf:preview": "opennextjs-cloudflare build -c wrangler.worker.jsonc && opennextjs-cloudflare preview -c wrangler.worker.jsonc",
    "cf:deploy": "opennextjs-cloudflare build -c wrangler.worker.jsonc && opennextjs-cloudflare deploy -c wrangler.worker.jsonc",
    "deploy": "opennextjs-cloudflare deploy -c wrangler.worker.jsonc",
    "upload": "opennextjs-cloudflare upload -c wrangler.worker.jsonc"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  }
}
